# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL. A long-running API should use a direct (non-pooler) URL; DIRECT_URL is used for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/karvia?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/karvia?sslmode=require

# Comma-separated list of browser origins allowed to call the API (web + admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Secrets: generate each with  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
OTP_PEPPER=change-me
FILE_URL_SECRET=change-me
# 32-byte key (base64) used to encrypt admin 2FA secrets at rest
DATA_KEY=change-me

# SMS: "console" prints OTPs to the server log (dev only). Production: "msg91".
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Dev only: return the OTP in the API response so you can log in without SMS. Ignored in production.
OTP_DEV_ECHO=true

# Payments: "mock" for local testing, "razorpay" for real payments.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Geocoding for address search (optional; GPS works without it). Server-side only.
GOOGLE_MAPS_API_KEY=

# Private file storage directory (never served directly)
STORAGE_DIR=./storage

# Phone number that becomes the first super admin when you run the seed
SEED_ADMIN_PHONE=9999999999

# Set true when the API runs behind a proxy / load balancer
TRUST_PROXY=false

# Max OTP requests per IP per hour (default 30)
OTP_PER_IP_PER_HOUR=30
